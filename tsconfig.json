{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true, // Include JS/JSX files
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "incremental": true,
    "module": "esnext",
    "esModuleInterop": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "baseUrl": ".", // Root of your project
    "paths": {
      "@/*": ["./src/*"],
      "ui/*": ["./src/components/ui/*"],
      "components/*": ["./src/components/*"],
      "lib/*": ["./src/lib/*"],
      "hooks/*": ["./src/hooks/*"]
    }
  },
  "include": [
    "src/**/*", // All JS/TS/TSX files in src
    "**/*.ts",
    "**/*.tsx",
    "**/*.js",
    "**/*.jsx"
  ],
  "exclude": ["node_modules"]
}
